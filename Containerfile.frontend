# ============================================================
# ETAPA 1: "build" — compila el proyecto React/Vite a archivos
# estáticos (HTML/CSS/JS)
# ============================================================
FROM node:24-alpine AS build

# --- Soporte de proxy corporativo (SYC) ---
# Igual que en el Containerfile del backend: sin esto, "npm ci"
# se quedaría intentando llegar a internet (registry.npmjs.org)
# sin lograrlo.
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=$HTTP_PROXY \
    HTTPS_PROXY=$HTTPS_PROXY \
    NO_PROXY=$NO_PROXY \
    http_proxy=$HTTP_PROXY \
    https_proxy=$HTTPS_PROXY \
    no_proxy=$NO_PROXY

WORKDIR /app

# Igual que con los .csproj del backend: copiamos primero solo los
# archivos que describen las dependencias (package.json y el
# "lockfile" con las versiones exactas), para aprovechar la caché
# de Podman mientras no cambien.
COPY SGDS.Frontend/package.json SGDS.Frontend/package-lock.json ./
RUN npm ci --ignore-scripts

# Ahora copiamos el resto del código fuente del frontend.
COPY SGDS.Frontend/ ./

# "npm run build" ejecuta lo que ya tienes definido en tu
# package.json: "tsc -b && vite build" — primero valida los tipos
# de TypeScript, y si todo está bien, genera los archivos finales
# en la carpeta /app/dist.
RUN npm run build

# ============================================================
# ETAPA 2: "final" — nginx sirviendo los archivos ya compilados
# ============================================================
FROM nginx:alpine AS final

# Reemplazamos la configuración por defecto de nginx por la
# nuestra, que sabe manejar el ruteo de una SPA de React.
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

# Copiamos ÚNICAMENTE el resultado compilado de la Etapa 1.
# No hay Node, no hay node_modules, no hay código fuente sin
# compilar en esta imagen final — solo HTML/CSS/JS y nginx.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
